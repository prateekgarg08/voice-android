# Copy this file to .env and add your credentials.
GEMINI_API_KEY=

# Optional: enable the OpenAI fallback when Gemini times out.
OPENAI_API_KEY=
# GEMINI_LLM_TIMEOUT_SECONDS=10
# OPENAI_FALLBACK_MODEL=gpt-4.1
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Optional model and logging settings.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# AGENT_LOG_FILE=logs/agent.jsonl
# AGENT_LOG_LEVEL=INFO

# Authenticated FastAPI gateway. Use Application Default Credentials or point
# GOOGLE_APPLICATION_CREDENTIALS to a Firebase service account JSON file.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repo/firebase-service-account.json
# ALLOWED_FIREBASE_UIDS=optional-uid-1,optional-uid-2
# ANDROID_SERIAL=optional-adb-device-serial
